---
import { t, formatText, getLocalizedPath, type Lang } from '../../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
---

  <!-- Hero del producto -->
  <section class="relative min-h-[70vh] flex items-center pt-24 lg:pb-16 overflow-hidden lala-hero">
    <!-- Background effects -->
    <div class="absolute inset-0 bg-[var(--color-bg-dark)]">
      <div class="absolute inset-0 opacity-20" style="background-image: linear-gradient(rgba(108, 92, 231, 0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(108, 92, 231, 0.1) 1px, transparent 1px); background-size: 50px 50px;"></div>
      <div class="absolute top-1/4 right-1/4 w-[600px] h-[600px] lg:w-[900px] lg:h-[900px] bg-[var(--color-primary)] rounded-full filter blur-[200px] lg:blur-[300px] opacity-20 lg:opacity-30"></div>
      <div class="absolute bottom-0 left-1/4 w-[400px] h-[400px] lg:w-[700px] lg:h-[700px] bg-[var(--color-secondary)] rounded-full filter blur-[150px] lg:blur-[250px] opacity-15 lg:opacity-25"></div>
    </div>
    
    <div class="container-custom relative z-10">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <!-- Breadcrumb -->
          <nav class="flex items-center gap-2 text-sm text-[var(--color-text-muted)] mb-8 lala-breadcrumb">
            <a href={getLocalizedPath(lang, '/')} class="hover:text-white transition-colors">{t(lang, 'common.breadcrumbHome')}</a>
            <span>/</span>
            <a href={getLocalizedPath(lang, '/#productos')} class="hover:text-white transition-colors">{t(lang, 'common.breadcrumbProducts')}</a>
            <span>/</span>
            <span class="text-[var(--color-primary)]">LALA AI</span>
          </nav>
          
          <!-- Badge -->
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[var(--color-primary)]/10 border border-[var(--color-primary)]/30 mb-6 lala-badge">
            <span class="w-2 h-2 rounded-full bg-[var(--color-accent-green)] animate-pulse"></span>
            <span class="text-sm text-[var(--color-primary-light)] font-medium">{t(lang, 'lala.badge')}</span>
            <span class="lala-stars">⭐⭐⭐⭐⭐</span>
          </div>
          
          <h1 class="heading-xl mb-6 lala-title">
            <img 
              src="https://lala.digital-x.com.co/logo_vertical.svg?v=2" 
              alt="LALA AI" 
              class="h-16 md:h-20 lg:h-28 w-auto"
            />
          </h1>
          
          <p class="text-xl text-[var(--color-text-secondary)] mb-8 leading-snug md:leading-relaxed lala-description">
            <span class="lg:hidden" set:html={formatText(t(lang, 'lala.descMobile'))}></span>
            <span class="hidden lg:inline" set:html={formatText(t(lang, 'lala.descDesktop'))}></span>
          </p>
          
          <!-- Quick stats -->
          <div class="grid grid-cols-3 gap-4 mb-8 lala-stats">
            <div class="text-center p-4 rounded-xl bg-white/5 border border-white/10 lala-stat-card">
              <div class="text-2xl font-bold text-gradient">5+</div>
              <div class="text-xs text-[var(--color-text-muted)]">{t(lang, 'lala.stat1Label')}</div>
            </div>
            <div class="text-center p-4 rounded-xl bg-white/5 border border-white/10 lala-stat-card">
              <div class="text-2xl font-bold text-gradient">50%</div>
              <div class="text-xs text-[var(--color-text-muted)]">{t(lang, 'lala.stat2Label')}</div>
            </div>
            <div class="text-center p-4 rounded-xl bg-white/5 border border-white/10 lala-stat-card">
              <div class="text-2xl font-bold text-gradient">24/7</div>
              <div class="text-xs text-[var(--color-text-muted)]">{t(lang, 'lala.stat3Label')}</div>
            </div>
          </div>
          
          <div class="flex flex-wrap gap-4 lala-buttons">
            <a href="#video" class="btn-primary">
              {t(lang, 'lala.ctaDemo')}
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ml-2">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
            </a>
            <a href={getLocalizedPath(lang, '/#contacto')} class="btn-secondary">
              {t(lang, 'lala.ctaInfo')}
            </a>
          </div>
        </div>
        
        <!-- Mockup del chat para mobile -->
        <div class="relative flex items-center justify-center mt-12 md:mt-0 lg:hidden">
          <div class="absolute inset-0 bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-secondary)] rounded-3xl filter blur-[100px] opacity-30 animate-pulse"></div>
          <div class="relative rounded-3xl overflow-hidden shadow-2xl border-4 border-white/20 max-h-[400px] md:max-h-[500px]">
            <img 
              src="/images/chat-lala-ai.jpg" 
              alt="LALA AI Chat Interface" 
              class="w-auto h-full max-w-[250px] md:max-w-[300px] object-contain"
            />
          </div>
        </div>
        <!-- Mockup del chat para desktop -->
        <div class="relative items-center justify-center hidden lg:flex lg:mt-16">
          <div class="absolute inset-0 bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-secondary)] rounded-3xl filter blur-[100px] opacity-30 animate-pulse"></div>
          <div class="relative rounded-3xl overflow-hidden shadow-2xl border-4 border-white/20 max-h-[550px]">
            <img 
              src="/images/chat-lala-ai.jpg" 
              alt="LALA AI Chat Interface" 
              class="w-auto h-full max-w-[350px] object-contain"
            />
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Características -->
  <section class="section-padding bg-[var(--color-bg-darker)]">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-16 lala-especial-header">
        <h2 class="heading-lg mb-4" set:html={formatText(t(lang, 'lala.featTitle'))}></h2>
        <p class="text-[var(--color-text-secondary)]">
          {t(lang, 'lala.featDesc')}
        </p>
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 lala-features-grid">
        <!-- Feature 1 -->
        <div class="card group lala-feature-card">
          <div class="w-14 h-14 rounded-2xl bg-[var(--color-primary)]/10 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform lala-feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-[var(--color-primary)]">
              <polygon points="23 7 16 12 23 17 23 7"></polygon>
              <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
            </svg>
          </div>
          <div class="lala-feature-content">
            <h3 class="text-xl font-bold text-white mb-3">{t(lang, 'lala.feat1Title')}</h3>
            <p class="text-[var(--color-text-secondary)]">
              {t(lang, 'lala.feat1Desc')}
            </p>
          </div>
        </div>
        
        <!-- Feature 2 -->
        <div class="card group lala-feature-card">
          <div class="w-14 h-14 rounded-2xl bg-[var(--color-secondary)]/10 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform lala-feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-[var(--color-secondary)]">
              <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
              <circle cx="9" cy="9" r="2"></circle>
              <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
            </svg>
          </div>
          <div class="lala-feature-content">
            <h3 class="text-xl font-bold text-white mb-3">{t(lang, 'lala.feat2Title')}</h3>
            <p class="text-[var(--color-text-secondary)]">
              {t(lang, 'lala.feat2Desc')}
            </p>
          </div>
        </div>
        
        <!-- Feature 3 -->
        <div class="card group lala-feature-card">
          <div class="w-14 h-14 rounded-2xl bg-[var(--color-accent-green)]/10 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform lala-feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-[var(--color-accent-green)]">
              <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
              <path d="M12 18h.01"></path>
            </svg>
          </div>
          <div class="lala-feature-content">
            <h3 class="text-xl font-bold text-white mb-3">{t(lang, 'lala.feat3Title')}</h3>
            <p class="text-[var(--color-text-secondary)]">
              {t(lang, 'lala.feat3Desc')}
            </p>
          </div>
        </div>
        
        <!-- Feature 4 -->
        <div class="card group lala-feature-card">
          <div class="w-14 h-14 rounded-2xl bg-[var(--color-accent-pink)]/10 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform lala-feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-[var(--color-accent-pink)]">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
          </div>
          <div class="lala-feature-content">
            <h3 class="text-xl font-bold text-white mb-3">{t(lang, 'lala.feat4Title')}</h3>
            <p class="text-[var(--color-text-secondary)]">
              {t(lang, 'lala.feat4Desc')}
            </p>
          </div>
        </div>
        
        <!-- Feature 5 -->
        <div class="card group lala-feature-card">
          <div class="w-14 h-14 rounded-2xl bg-[var(--color-accent-orange)]/10 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform lala-feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-[var(--color-accent-orange)]">
              <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
              <path d="M12 18h.01"></path>
            </svg>
          </div>
          <div class="lala-feature-content">
            <h3 class="text-xl font-bold text-white mb-3">{t(lang, 'lala.feat5Title')}</h3>
            <p class="text-[var(--color-text-secondary)]">
              {t(lang, 'lala.feat5Desc')}
            </p>
          </div>
        </div>
        
        <!-- Feature 6 -->
        <div class="card group lala-feature-card">
          <div class="w-14 h-14 rounded-2xl bg-[var(--color-primary)]/10 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform lala-feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-[var(--color-primary)]">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <div class="lala-feature-content">
            <h3 class="text-xl font-bold text-white mb-3">{t(lang, 'lala.feat6Title')}</h3>
            <p class="text-[var(--color-text-secondary)]">
              {t(lang, 'lala.feat6Desc')}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Modelos disponibles -->
  <section class="section-padding">
    <div class="container-custom flex flex-col items-center">
      <div class="text-center max-w-3xl w-full mb-12 md:mb-16 lala-modelos-header">
        <h2 class="heading-lg mb-4 lg:hidden">{t(lang, 'lala.modelsLabel')}</h2>
        <h2 class="heading-lg mb-4 hidden lg:block">{t(lang, 'lala.modelsTitle')}</h2>
        <p class="text-[var(--color-text-secondary)] lg:hidden">
          {t(lang, 'lala.modelsDesc')}
        </p>
        <p class="text-[var(--color-text-secondary)] hidden lg:block">
          {t(lang, 'lala.modelsNote')}
        </p>
      </div>
      
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 md:gap-5 w-full lala-modelos-grid">
        <!-- OpenAI -->
        <div class="card flex flex-col items-center justify-center text-center aspect-square p-4 md:p-5 group hover:border-[var(--color-primary)]/50 transition-all lala-modelo-card">
          <div class="w-12 h-12 md:w-14 md:h-14 lg:w-16 lg:h-16 mb-2 md:mb-3 rounded-xl bg-white flex items-center justify-center group-hover:scale-110 transition-transform p-2">
            <img src="/images/logo-openai.svg" alt="OpenAI" class="w-full h-full object-contain" />
          </div>
          <h4 class="font-semibold text-white text-sm md:text-base leading-tight">OpenAI</h4>
          <p class="text-[10px] md:text-xs text-[var(--color-text-muted)] leading-tight mt-0.5">GPT-4o, GPT-4</p>
        </div>
        
        <!-- Anthropic -->
        <div class="card flex flex-col items-center justify-center text-center aspect-square p-4 md:p-5 group hover:border-[var(--color-secondary)]/50 transition-all lala-modelo-card">
          <div class="w-12 h-12 md:w-14 md:h-14 lg:w-16 lg:h-16 mb-2 md:mb-3 rounded-xl bg-white flex items-center justify-center group-hover:scale-110 transition-transform p-2">
            <img src="/images/logo-anthropic.svg" alt="Anthropic" class="w-full h-full object-contain" />
          </div>
          <h4 class="font-semibold text-white text-sm md:text-base leading-tight">Anthropic</h4>
          <p class="text-[10px] md:text-xs text-[var(--color-text-muted)] leading-tight mt-0.5">Claude 3.5</p>
        </div>
        
        <!-- Google -->
        <div class="card flex flex-col items-center justify-center text-center aspect-square p-4 md:p-5 group hover:border-[var(--color-accent-green)]/50 transition-all lala-modelo-card">
          <div class="w-12 h-12 md:w-14 md:h-14 lg:w-16 lg:h-16 mb-2 md:mb-3 rounded-xl bg-white flex items-center justify-center group-hover:scale-110 transition-transform p-2">
            <img src="/images/logo-google-gemini.svg" alt="Google Gemini" class="w-full h-full object-contain" />
          </div>
          <h4 class="font-semibold text-white text-sm md:text-base leading-tight">Google</h4>
          <p class="text-[10px] md:text-xs text-[var(--color-text-muted)] leading-tight mt-0.5">Gemini Pro</p>
        </div>
        
        <!-- Groq -->
        <div class="card flex flex-col items-center justify-center text-center aspect-square p-4 md:p-5 group hover:border-[var(--color-accent-orange)]/50 transition-all lala-modelo-card">
          <div class="w-12 h-12 md:w-14 md:h-14 lg:w-16 lg:h-16 mb-2 md:mb-3 rounded-xl bg-white flex items-center justify-center group-hover:scale-110 transition-transform p-2">
            <img src="/images/logo-groq.svg" alt="Groq" class="w-full h-full object-contain" />
          </div>
          <h4 class="font-semibold text-white text-sm md:text-base leading-tight">Groq</h4>
          <p class="text-[10px] md:text-xs text-[var(--color-text-muted)] leading-tight mt-0.5">{t(lang, 'lala.modelGroq')}</p>
        </div>
        
        <!-- DeepSeek -->
        <div class="card flex flex-col items-center justify-center text-center aspect-square p-4 md:p-5 group hover:border-[var(--color-accent-pink)]/50 transition-all lala-modelo-card">
          <div class="w-12 h-12 md:w-14 md:h-14 lg:w-16 lg:h-16 mb-2 md:mb-3 rounded-xl bg-white flex items-center justify-center group-hover:scale-110 transition-transform p-2">
            <img src="/images/logo-deepseek.svg" alt="DeepSeek" class="w-full h-full object-contain" />
          </div>
          <h4 class="font-semibold text-white text-sm md:text-base leading-tight">DeepSeek</h4>
          <p class="text-[10px] md:text-xs text-[var(--color-text-muted)] leading-tight mt-0.5">{t(lang, 'lala.modelDeepSeek')}</p>
        </div>
        
        <!-- Más -->
        <div class="card flex flex-col items-center justify-center text-center aspect-square p-4 md:p-5 group hover:border-white/30 transition-all lala-modelo-card">
          <div class="w-12 h-12 md:w-14 md:h-14 lg:w-16 lg:h-16 mb-2 md:mb-3 rounded-xl bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-secondary)] flex items-center justify-center group-hover:scale-110 transition-transform">
            <span class="text-xl md:text-2xl font-bold text-white">+</span>
          </div>
          <h4 class="font-semibold text-white text-sm md:text-base leading-tight">{t(lang, 'lala.modelMore')}</h4>
          <p class="text-[10px] md:text-xs text-[var(--color-text-muted)] leading-tight mt-0.5" set:html={t(lang, 'lala.modelMoreDesc').replace(' ', '<br/>')}></p>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Video -->
  <section id="video" class="section-padding bg-[var(--color-bg-darker)]">
    <div class="container-custom flex flex-col items-center">
      <div class="text-center max-w-3xl w-full mb-12 lala-video-header">
        <h2 class="heading-lg mb-4" set:html={formatText(t(lang, 'lala.videoTitle'))}></h2>
        <p class="text-[var(--color-text-secondary)]">
          {t(lang, 'lala.videoDesc')}
        </p>
      </div>
      
      <div class="max-w-4xl w-full">
        <div class="relative group">
          <div class="absolute -inset-4 bg-gradient-to-r from-[var(--color-primary)] via-[var(--color-secondary)] to-[var(--color-primary)] rounded-3xl opacity-20 blur-xl group-hover:opacity-30 transition-opacity"></div>
          <div class="relative glass rounded-2xl overflow-hidden">
            <div class="aspect-video">
              <iframe
                src="https://www.youtube.com/embed/_1cUAEq2rpM?rel=0&modestbranding=1"
                title="LALA AI Demo"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
                class="w-full h-full"
                loading="lazy"
              ></iframe>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- CTA Final -->
  <section class="section-padding lala-cta-section">
    <div class="container-custom">
      <div class="card p-12 text-center relative overflow-hidden lala-cta-card">
        <div class="absolute inset-0 bg-gradient-to-r from-[var(--color-primary)]/20 to-[var(--color-secondary)]/20"></div>
        <div class="relative z-10">
          <h2 class="heading-lg mb-4 lala-cta-title" set:html={formatText(t(lang, 'lala.ctaTitle'))}></h2>
          <p class="text-[var(--color-text-secondary)] mb-8 max-w-2xl mx-auto lala-cta-text">
            {t(lang, 'lala.ctaDesc')}
          </p>
          <a href={getLocalizedPath(lang, '/#contacto')} class="btn-primary inline-flex lala-cta-btn">
            {t(lang, 'lala.ctaInfo')}
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ml-2">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
