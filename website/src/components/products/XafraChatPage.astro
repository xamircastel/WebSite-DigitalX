---
import { t, formatText, getLocalizedPath, type Lang } from '../../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
---

  <!-- Hero -->
  <section class="relative min-h-[70vh] flex items-center pt-24 lg:pb-16 overflow-hidden">
    <div class="absolute inset-0 bg-[var(--color-bg-dark)]">
      <div class="absolute inset-0 opacity-20" style="background-image: linear-gradient(rgba(255, 107, 157, 0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 107, 157, 0.1) 1px, transparent 1px); background-size: 50px 50px;"></div>
      <div class="absolute top-1/4 right-1/4 w-[600px] h-[600px] lg:w-[900px] lg:h-[900px] bg-[var(--color-accent-pink)] rounded-full filter blur-[200px] lg:blur-[300px] opacity-20 lg:opacity-30"></div>
      <div class="absolute bottom-0 left-0 w-[400px] h-[400px] lg:w-[700px] lg:h-[700px] bg-[var(--color-primary)] rounded-full filter blur-[200px] lg:blur-[250px] opacity-0 lg:opacity-20"></div>
    </div>
    
    <div class="container-custom relative z-10">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <nav class="flex items-center gap-2 text-sm text-[var(--color-text-muted)] mb-8">
            <a href={getLocalizedPath(lang, '/')} class="hover:text-white transition-colors">{t(lang, 'common.breadcrumbHome')}</a>
            <span>/</span>
            <a href={getLocalizedPath(lang, '/#productos')} class="hover:text-white transition-colors">{t(lang, 'common.breadcrumbProducts')}</a>
            <span>/</span>
            <span class="text-[var(--color-accent-pink)]">XafraChat</span>
          </nav>
          
          <!-- 18+ Badge -->
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-red-500/20 border border-red-500/50 mb-6 xafrachat-badge">
            <span class="text-sm text-red-400 font-bold">{t(lang, 'xafra.adultBadge')}</span>
          </div>
          
          <div class="mb-6 xafrachat-logo">
            <img src="/images/xafrachat-logo.png" alt="XafraChat" class="xafrachat-logo-img" />
          </div>
          
          <p class="text-xl text-[var(--color-text-secondary)] mb-8 leading-relaxed" set:html={formatText(t(lang, 'xafra.desc'))} />
          
          <div class="grid grid-cols-3 gap-4 mb-8 xafrachat-stats">
            <div class="text-center p-4 rounded-xl bg-white/5 border border-white/10">
              <div class="text-2xl font-bold text-[var(--color-accent-pink)]">24/7</div>
              <div class="text-xs text-[var(--color-text-muted)]">{t(lang, 'xafra.stat1Label')}</div>
            </div>
            <div class="text-center p-4 rounded-xl bg-white/5 border border-white/10">
              <div class="text-2xl font-bold text-[var(--color-accent-pink)]">HD</div>
              <div class="text-xs text-[var(--color-text-muted)]">{t(lang, 'xafra.stat2Label')}</div>
            </div>
            <div class="text-center p-4 rounded-xl bg-white/5 border border-white/10">
              <div class="text-2xl font-bold text-[var(--color-accent-pink)]">Live</div>
              <div class="text-xs text-[var(--color-text-muted)]">{t(lang, 'xafra.stat3Label')}</div>
            </div>
          </div>
          
          <div class="flex flex-wrap gap-4 xafrachat-buttons">
            <a href="#video" class="btn-primary xafrachat-btn" style="background: var(--color-accent-pink);">
              {t(lang, 'xafra.ctaDemo')}
            </a>
            <a href={getLocalizedPath(lang, '/#contacto')} class="btn-secondary xafrachat-btn">
              {t(lang, 'xafra.ctaInfo')}
            </a>
          </div>
        </div>
        
        <div class="relative flex items-center justify-center xafrachat-carousel-container">
          <div class="absolute inset-0 bg-[var(--color-accent-pink)] rounded-full filter blur-[100px] opacity-30 animate-pulse"></div>
          
          <!-- Carrusel horizontal -->
          <div class="relative w-64 md:w-72 overflow-hidden rounded-3xl shadow-2xl xafrachat-carousel-wrapper">
            <div class="xafrachat-carousel-horizontal">
              <img src="/images/xafrachat-carrusel1.png" alt="XafraChat 1" class="xafrachat-slide" />
              <img src="/images/xafrachat-carrusel2.png" alt="XafraChat 2" class="xafrachat-slide" />
              <img src="/images/xafrachat-carrusel3.png" alt="XafraChat 3" class="xafrachat-slide" />
              <img src="/images/xafrachat-carrusel1.png" alt="XafraChat 1" class="xafrachat-slide" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Características -->
  <section class="section-padding bg-[var(--color-bg-darker)] xafrachat-features-section">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-16 xafrachat-features-header">
        <h2 class="heading-lg mb-4" set:html={formatText(t(lang, 'xafra.featTitle'))} />
      </div>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 xafrachat-features-grid">
        <div class="card group xafrachat-feature-card">
          <div class="w-14 h-14 rounded-2xl bg-[var(--color-accent-pink)]/10 flex items-center justify-center mb-6 xafrachat-feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-[var(--color-accent-pink)]">
              <path d="M23 7l-7 5 7 5V7z"></path>
              <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
            </svg>
          </div>
          <div class="xafrachat-feature-content">
            <h3 class="text-xl font-bold text-white mb-3">{t(lang, 'xafra.feat1Title')}</h3>
            <p class="text-[var(--color-text-secondary)]">{t(lang, 'xafra.feat1Desc')}</p>
          </div>
        </div>
        
        <div class="card group xafrachat-feature-card">
          <div class="w-14 h-14 rounded-2xl bg-[var(--color-accent-pink)]/10 flex items-center justify-center mb-6 xafrachat-feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-[var(--color-accent-pink)]">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
          </div>
          <div class="xafrachat-feature-content">
            <h3 class="text-xl font-bold text-white mb-3">{t(lang, 'xafra.feat2Title')}</h3>
            <p class="text-[var(--color-text-secondary)]">{t(lang, 'xafra.feat2Desc')}</p>
          </div>
        </div>
        
        <div class="card group xafrachat-feature-card">
          <div class="w-14 h-14 rounded-2xl bg-[var(--color-accent-pink)]/10 flex items-center justify-center mb-6 xafrachat-feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-[var(--color-accent-pink)]">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <div class="xafrachat-feature-content">
            <h3 class="text-xl font-bold text-white mb-3">{t(lang, 'xafra.feat3Title')}</h3>
            <p class="text-[var(--color-text-secondary)]">{t(lang, 'xafra.feat3Desc')}</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Video -->
  <section id="video" class="section-padding xafrachat-video-section">
    <div class="container-custom">
      <div class="text-center max-w-3xl mx-auto mb-12 xafrachat-video-header">
        <h2 class="heading-lg mb-4" set:html={formatText(t(lang, 'xafra.videoTitle'))} />
      </div>
      
      <div class="max-w-md mx-auto">
        <div class="relative group">
          <div class="absolute -inset-4 bg-[var(--color-accent-pink)] rounded-3xl opacity-20 blur-xl"></div>
          <div class="relative glass rounded-2xl overflow-hidden">
            <div class="aspect-[9/16]">
              <iframe
                src="https://www.youtube.com/embed/ye0BVK0G1tU?rel=0&modestbranding=1"
                title="XafraChat Demo"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                class="w-full h-full"
                loading="lazy"
              ></iframe>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- CTA -->
  <section class="section-padding bg-[var(--color-bg-darker)]">
    <div class="container-custom">
      <div class="card p-12 text-center relative overflow-hidden">
        <div class="absolute inset-0 bg-[var(--color-accent-pink)]/10"></div>
        <div class="relative z-10">
          <h2 class="heading-lg mb-4" set:html={formatText(t(lang, 'xafra.ctaTitle'))} />
          <p class="text-[var(--color-text-secondary)] mb-8 max-w-2xl mx-auto xafrachat-cta-text">
            {t(lang, 'xafra.ctaDesc')}
          </p>
          <a href={getLocalizedPath(lang, '/#contacto')} class="btn-primary inline-flex xafrachat-cta-btn" style="background: var(--color-accent-pink);">
            {t(lang, 'xafra.ctaInfo')}
          </a>
        </div>
      </div>
    </div>
  </section>
