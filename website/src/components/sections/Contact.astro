---
// Contact Section - Formulario de contacto
import { t, formatText, getLocalizedPath, type Lang, defaultLang } from '../../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
---

<section id="contacto" class="section-padding mt-8 lg:mt-16 lg:mb-16 contact-section">
  <div class="container-custom">
    
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      
      <!-- Información de contacto -->
      <div class="animate-on-scroll">
        <span class="inline-block text-[var(--color-primary)] text-sm font-semibold uppercase tracking-widest mb-4 contact-section-label">
          {t(lang, 'contact.label')}
        </span>
        <h2 class="heading-lg mb-6 contact-title" set:html={formatText(t(lang, 'contact.title'))} />
        <p class="text-[var(--color-text-secondary)] text-lg mb-8 contact-description">
          {t(lang, 'contact.description')}
        </p>
        
        <!-- Info cards -->
        <div class="space-y-4 contact-info-cards">
          <!-- Email -->
          <div class="flex items-start gap-4 p-4 rounded-xl bg-[var(--color-bg-card)] border border-white/5">
            <div class="w-12 h-12 rounded-xl bg-[var(--color-primary)]/10 flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-[var(--color-primary)]">
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </div>
            <div>
              <h4 class="text-white font-semibold mb-1">{t(lang, 'contact.emailLabel')}</h4>
              <a href="mailto:comercial@digital-x.com.co" class="text-[var(--color-text-secondary)] hover:text-[var(--color-primary)] transition-colors">
                comercial@digital-x.com.co
              </a>
            </div>
          </div>
          
          <!-- Ubicaciones -->
          <div class="flex items-start gap-4 p-4 rounded-xl bg-[var(--color-bg-card)] border border-white/5">
            <div class="w-12 h-12 rounded-xl bg-[var(--color-secondary)]/10 flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-[var(--color-secondary)]">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <div>
              <h4 class="text-white font-semibold mb-1">{t(lang, 'contact.locationsLabel')}</h4>
              <p class="text-[var(--color-text-secondary)]">
                {t(lang, 'contact.locations')}
              </p>
            </div>
          </div>
          
          <!-- Horario -->
          <div class="flex items-start gap-4 p-4 rounded-xl bg-[var(--color-bg-card)] border border-white/5">
            <div class="w-12 h-12 rounded-xl bg-[var(--color-accent-green)]/10 flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-[var(--color-accent-green)]">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <div>
              <h4 class="text-white font-semibold mb-1">{t(lang, 'contact.hoursLabel')}</h4>
              <p class="text-[var(--color-text-secondary)]">
                {t(lang, 'contact.hours')}
              </p>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Formulario -->
      <div class="animate-on-scroll" style="animation-delay: 0.2s;">
        <form 
          id="contact-form"
          action="https://formsubmit.co/stefania.p@digital-x.com.co" 
          method="POST"
          class="card p-8"
        >
          <!-- Honeypot anti-spam -->
          <input type="text" name="_honey" style="display:none">
          <!-- Desactivar captcha -->
          <input type="hidden" name="_captcha" value="false">
          <!-- Página de agradecimiento (se establece dinámicamente) -->
          <input type="hidden" name="_next" id="form-next" value="">
          <!-- Asunto del email -->
          <input type="hidden" name="_subject" value="Nuevo mensaje de soporte - Digital-X">
          
          <h3 class="text-xl font-bold text-white mb-6">{t(lang, 'contact.formTitle')}</h3>
          
          <div class="space-y-5">
            <!-- Nombre -->
            <div>
              <label for="name" class="block text-sm font-medium text-[var(--color-text-secondary)] mb-2">
                {t(lang, 'contact.nameLabel')}
              </label>
              <input 
                type="text" 
                id="name" 
                name="name" 
                required
                class="w-full px-4 py-3 rounded-xl bg-[var(--color-bg-darker)] border border-white/10 text-white placeholder-[var(--color-text-muted)] focus:border-[var(--color-primary)] focus:ring-1 focus:ring-[var(--color-primary)] outline-none transition-all"
                placeholder={t(lang, 'contact.namePlaceholder')}
              />
            </div>
            
            <!-- Email -->
            <div>
              <label for="email" class="block text-sm font-medium text-[var(--color-text-secondary)] mb-2">
                {t(lang, 'contact.emailFieldLabel')}
              </label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required
                class="w-full px-4 py-3 rounded-xl bg-[var(--color-bg-darker)] border border-white/10 text-white placeholder-[var(--color-text-muted)] focus:border-[var(--color-primary)] focus:ring-1 focus:ring-[var(--color-primary)] outline-none transition-all"
                placeholder={t(lang, 'contact.emailPlaceholder')}
              />
            </div>
            
            <!-- Número de móvil -->
            <div>
              <label for="phone" class="block text-sm font-medium text-[var(--color-text-secondary)] mb-2">
                {t(lang, 'contact.phoneLabel')}
              </label>
              <input 
                type="tel" 
                id="phone" 
                name="phone" 
                required
                class="w-full px-4 py-3 rounded-xl bg-[var(--color-bg-darker)] border border-white/10 text-white placeholder-[var(--color-text-muted)] focus:border-[var(--color-primary)] focus:ring-1 focus:ring-[var(--color-primary)] outline-none transition-all"
                placeholder={t(lang, 'contact.phonePlaceholder')}
              />
            </div>
            
            <!-- Asunto -->
            <div>
              <label for="subject" class="block text-sm font-medium text-[var(--color-text-secondary)] mb-2">
                {t(lang, 'contact.subjectLabel')}
              </label>
              <select 
                id="subject" 
                name="subject" 
                required
                class="w-full px-4 py-3 rounded-xl bg-[var(--color-bg-darker)] border border-white/10 text-white focus:border-[var(--color-primary)] focus:ring-1 focus:ring-[var(--color-primary)] outline-none transition-all"
              >
                <option value="" disabled selected>{t(lang, 'contact.subjectDefault')}</option>
                <option value="Cancelar suscripción" class="bg-[#0A0A0F] text-white">{t(lang, 'contact.subjectOpt1')}</option>
                <option value="Ayuda con el servicio" class="bg-[#0A0A0F] text-white">{t(lang, 'contact.subjectOpt2')}</option>
                <option value="Problemas con el servicio" class="bg-[#0A0A0F] text-white">{t(lang, 'contact.subjectOpt3')}</option>
                <option value="Problemas generando videos" class="bg-[#0A0A0F] text-white">{t(lang, 'contact.subjectOpt4')}</option>
                <option value="Problemas generando imágenes" class="bg-[#0A0A0F] text-white">{t(lang, 'contact.subjectOpt5')}</option>
                <option value="Suscripción no solicitada" class="bg-[#0A0A0F] text-white">{t(lang, 'contact.subjectOpt6')}</option>
              </select>
            </div>
            
            <!-- Mensaje -->
            <div>
              <label for="message" class="block text-sm font-medium text-[var(--color-text-secondary)] mb-2">
                {t(lang, 'contact.messageLabel')}
              </label>
              <textarea 
                id="message" 
                name="message" 
                rows="4" 
                required
                class="w-full px-4 py-3 rounded-xl bg-[var(--color-bg-darker)] border border-white/10 text-white placeholder-[var(--color-text-muted)] focus:border-[var(--color-primary)] focus:ring-1 focus:ring-[var(--color-primary)] outline-none transition-all resize-none"
                placeholder={t(lang, 'contact.messagePlaceholder')}
              ></textarea>
            </div>
            
            <!-- Submit -->
            <button 
              type="submit" 
              class="btn-primary w-full justify-center"
            >
              {t(lang, 'contact.submit')}
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ml-2">
                <path d="m22 2-7 20-4-9-9-4Z"></path>
                <path d="M22 2 11 13"></path>
              </svg>
            </button>
          </div>
        </form>
      </div>
      
    </div>
    
  </div>
</section>

<script>
  (function() {
    const path = window.location.pathname;
    const langMatch = path.match(/^\/(en|zh|hi|fr)(\/|$)/);
    const prefix = langMatch ? '/' + langMatch[1] : '';
    document.getElementById('form-next').value = window.location.origin + prefix + '/gracias/';
  })();
</script>
