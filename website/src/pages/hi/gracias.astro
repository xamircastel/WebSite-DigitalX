---
import MainLayout from '../../layouts/MainLayout.astro';
import { t, formatText, getLocalizedPath, type Lang } from '../../i18n/utils';

const lang: Lang = 'hi';
---

<MainLayout 
  lang={lang}
  title={t(lang, 'meta.thanksTitle')}
  description={t(lang, 'meta.thanksDesc')}
>
  <section class="relative min-h-[80vh] flex items-center justify-center">
    <div class="absolute inset-0 bg-[var(--color-bg-dark)] -z-10">
      <div class="absolute inset-0 opacity-20 -z-10" style="background-image: linear-gradient(rgba(108, 92, 231, 0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(108, 92, 231, 0.1) 1px, transparent 1px); background-size: 50px 50px;"></div>
      <div class="absolute top-1/3 left-1/3 w-[600px] h-[600px] bg-[var(--color-primary)] rounded-full filter blur-[200px] opacity-15 -z-10"></div>
      <div class="absolute bottom-1/3 right-1/3 w-[500px] h-[500px] bg-[var(--color-accent-green)] rounded-full filter blur-[200px] opacity-10 -z-10"></div>
    </div>

    <div class="container-custom pt-32 pb-16" style="display: flex; flex-direction: column; align-items: center; text-align: center;">
      <div class="w-20 h-20 mx-auto mb-8 rounded-full bg-[var(--color-accent-green)]/15 border border-[var(--color-accent-green)]/30 flex items-center justify-center animate-fade-in-up">
        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-[var(--color-accent-green)]">
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
          <polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
      </div>

      <h1 class="heading-lg mb-6 animate-fade-in-up" style="animation-delay: 0.1s;" set:html={formatText(t(lang, 'thanks.title'))} />
      <p class="text-xl text-[var(--color-text-secondary)] mb-4 max-w-2xl mx-auto animate-fade-in-up leading-relaxed" style="animation-delay: 0.2s;" set:html={formatText(t(lang, 'thanks.message'))} />
      <p class="text-[var(--color-text-muted)] mb-10 max-w-xl mx-auto animate-fade-in-up" style="animation-delay: 0.3s;">{t(lang, 'thanks.spam')}</p>

      <div class="animate-fade-in-up" style="animation-delay: 0.4s;">
        <a href={getLocalizedPath(lang, '/')} class="btn-primary inline-flex">
          {t(lang, 'thanks.back')}
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ml-2">
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </section>
</MainLayout>
